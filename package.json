{
  "name": "@wastee/dsh-goal-record-board",
  "version": "1.0.3",
  "description": "把每个轮次的最终回答显示到右栏看板；列表只显示第一段，点开看全文。",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "goal",
    "board",
    "session"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wastee/dsh-goal-record-board.git"
  },
  "bugs": {
    "url": "https://github.com/wastee/dsh-goal-record-board/issues"
  },
  "homepage": "https://github.com/wastee/dsh-goal-record-board#readme",
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
